/* components/ai-sheet/ai-sheet.wxss */

/* ---------------- 遮罩 + 进退场 ---------------- */
.mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: 200;
  background: rgba(0, 0, 0, 0.5);
  animation: mask-in 0.22s ease-out both;
}
.mask.mask-out { animation: mask-out 0.2s ease-in both; }
@keyframes mask-in { from { background: rgba(0, 0, 0, 0); } to { background: rgba(0, 0, 0, 0.5); } }
@keyframes mask-out { from { background: rgba(0, 0, 0, 0.5); } to { background: rgba(0, 0, 0, 0); } }

.wrap {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  padding: 0 28rpx;
}
/* 进场只淡入，纵向位移交给键盘同步，避免「先弹出再被顶起」两段硬切 */
.wrap-in { animation: sheet-in 0.2s ease-out both; }
.wrap-out { animation: sheet-out 0.2s ease-in both; }
@keyframes sheet-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes sheet-out { from { transform: translateY(24rpx); opacity: 1; } to { transform: translateY(40rpx); opacity: 0; } }

/* 随键盘平移：时长跟 onKeyboardHeightChange / keyboardheightchange 的 duration，曲线接近系统键盘 */
.lift {
  transition-property: transform;
  transition-timing-function: cubic-bezier(0.17, 0.59, 0.4, 0.99);
  transition-duration: 250ms;
  will-change: transform;
  /* 常驻底边距：Home 条安全区。键盘升起时 lift 位移 = 键盘高度 - 安全区，卡片正好贴在键盘上方 20rpx */
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

/* 日历弹出时，输入卡片（含标题 / 浮层）收起；关闭时展开回来。
   动效编排（日历面板 .date-sheet 同步）：
     打开：卡片先行——短促加速淡出并略微下沉（0.18s）；面板晚 0.06s 起步，减速滑入（0.36s），落点自然收住
     关闭：面板先落下（0.24s 加速）；卡片晚 0.1s 起步，从下方轻轻浮起并减速收尾（0.34s）
   visibility 只在收起结束后才关闭（展开时立刻恢复），隐藏期间不可点 */
.stack {
  transform-origin: 50% 100%;
  will-change: transform, opacity;
  transition: transform 0.34s cubic-bezier(0.22, 1, 0.36, 1) 0.1s, opacity 0.26s ease-out 0.1s;
}
.stack.stack-hide {
  transform: translate3d(0, 48rpx, 0) scale(0.96);
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: transform 0.18s cubic-bezier(0.4, 0, 1, 1), opacity 0.16s ease-in, visibility 0s linear 0.18s;
}

.ledger {
  padding: 0 8rpx 16rpx;
  font-size: 34rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.card-wrap { position: relative; }

/* ---------------- 输入卡片 ---------------- */
.card-box {
  position: relative;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx 28rpx 24rpx;
  overflow: hidden;
}

.ta {
  width: calc(100% - 104rpx); /* 右上角 ✓ 占 120rpx 的 1/4 圆，文字不要伸到它下面 */
  height: 150rpx;
  font-size: 32rpx;
  line-height: 1.5;
  color: #1A1A1A;
}
.ta-ph { color: #B3B9BF; font-size: 30rpx; line-height: 1.5; }
.ph { color: #B3B9BF; font-size: 27rpx; }

/* 右上角四分之一圆 ✓（半径 150rpx → 120rpx，略小一圈） */
.ok {
  position: absolute;
  top: 0; right: 0;
  width: 120rpx; height: 120rpx;
  border-radius: 0 0 0 120rpx;
  background: #D6D8DB;
  transition: background 0.2s ease;
}
.ok.ok-on { background: #45A888; }
.ok-tick {
  position: absolute;
  right: 28rpx; top: 32rpx;
  width: 34rpx; height: 19rpx;
  border-left: 4rpx solid #FFFFFF;
  border-bottom: 4rpx solid #FFFFFF;
  transform: rotate(-45deg);
}
.ok-spin {
  position: absolute;
  right: 29rpx; top: 29rpx;
  width: 30rpx; height: 30rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.45);
  border-top-color: #FFFFFF;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* ---------------- chips ---------------- */
.chips { display: flex; flex-wrap: wrap; align-items: center; margin-top: 12rpx; white-space: nowrap; }
.chip {
  display: inline-flex;
  align-items: center;
  height: 62rpx;
  padding: 0 18rpx;
  margin: 8rpx 14rpx 8rpx 0;
  background: #F5F6F8;
  border-radius: 14rpx;
  font-size: 26rpx;
  color: #333;
  max-width: 260rpx;
}
.chip-t { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.chip-img { width: 36rpx; height: 36rpx; margin-right: 8rpx; flex-shrink: 0; }
.chip-img:last-child { margin-right: 0; }
.chip-active { background: #E9F5F0; color: #2E9C7C; }
.chip-open { box-shadow: inset 0 0 0 2rpx #45A888; }

.chip-noacc {
  position: relative;
  width: 32rpx; height: 24rpx;
  margin-right: 8rpx;
  border: 3rpx solid #9AA0A6;
  border-radius: 5rpx;
  overflow: hidden;
  flex-shrink: 0;
}
.chip-noacc-slash {
  position: absolute;
  left: -6rpx; top: 10rpx;
  width: 44rpx; height: 3rpx;
  background: #9AA0A6;
  transform: rotate(-28deg);
}

/* 日历图标：纯 CSS（无图片/字体），中间显示当天号数 */
.cal-ico {
  position: relative;
  width: 38rpx; height: 38rpx;
  margin-right: 8rpx;
  border: 3rpx solid #333;
  border-top-width: 9rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.cal-ico:last-child { margin-right: 0; }
.cal-num { font-size: 20rpx; line-height: 1; font-weight: 600; color: #333; }
.chip-active .cal-ico { border-color: #2E9C7C; }
.chip-active .cal-num { color: #2E9C7C; }

/* ---------------- 浮层（卡片上方，随卡片一起被键盘抬起） ---------------- */
.pop {
  position: absolute;
  left: 0;
  bottom: calc(100% + 14px);
  width: 70%;
  min-width: 520rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 44rpx rgba(0, 0, 0, 0.2);
  overflow: hidden;
  z-index: 5;
  transform-origin: left bottom;
  animation: pop-in 0.16s ease-out both;
}
@keyframes pop-in { from { opacity: 0; transform: scale(0.94); } to { opacity: 1; transform: scale(1); } }

.pop-head {
  height: 96rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
}
.pop-title { flex: 1; font-size: 30rpx; color: #1A1A1A; }
.pop-back {
  width: 56rpx; height: 56rpx;
  margin: 0 4rpx 0 -14rpx;
  display: flex; align-items: center; justify-content: center;
}

/* 右上角图标：两条圆角横条叠放（平铺 ⇄ 二级菜单） */
.pop-tog {
  width: 56rpx; height: 56rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.tg-bar { width: 38rpx; height: 15rpx; margin: 3rpx 0; border-radius: 5rpx; background: #3A3F45; }
.pop-tog.on .tg-bar { background: #45A888; }

.pop-scroll { width: 100%; }
.pop-row {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 28rpx;
}
.pop-row:active { background: #F5F6F8; }
.pr-icon { width: 40rpx; height: 40rpx; margin-right: 24rpx; flex-shrink: 0; }
.pr-icon.pr-tag { width: 34rpx; height: 34rpx; margin: 0 27rpx 0 3rpx; }
.pr-name { flex: 1; min-width: 0; font-size: 29rpx; color: #1A1A1A; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.pr-cnt { font-size: 24rpx; color: #9AA3AD; margin: 0 8rpx 0 16rpx; }

/* 「无账户」图标：银行卡 + 斜线（放大版） */
.noacc {
  position: relative;
  width: 40rpx; height: 30rpx;
  margin-right: 24rpx;
  border: 3rpx solid #3A3F45;
  border-radius: 6rpx;
  overflow: hidden;
  flex-shrink: 0;
}
.noacc-x {
  position: absolute;
  left: -6rpx; top: 12rpx;
  width: 56rpx; height: 3rpx;
  background: #3A3F45;
  transform: rotate(-28deg);
}

/* 选中勾 / 分组上的选中点 / 箭头：纯 CSS，不占图片体积 */
.tick {
  width: 24rpx; height: 13rpx;
  margin-right: 6rpx;
  border-left: 4rpx solid #45A888;
  border-bottom: 4rpx solid #45A888;
  transform: rotate(-45deg) translateY(-3rpx);
  flex-shrink: 0;
}
.dot-sel { width: 14rpx; height: 14rpx; border-radius: 50%; background: #45A888; margin-left: 12rpx; flex-shrink: 0; }
.chev {
  width: 14rpx; height: 14rpx;
  border-top: 3rpx solid #B3B9BF;
  border-right: 3rpx solid #B3B9BF;
  transform: rotate(45deg);
  margin: 0 6rpx 0 8rpx;
  flex-shrink: 0;
}
.chev.chev-l { transform: rotate(-135deg); border-color: #3A3F45; margin: 0 0 0 8rpx; }

/* ---------------- 标签浮层 ---------------- */
.tag-new { display: flex; align-items: center; padding: 0 28rpx 12rpx; }
.tag-input {
  flex: 1;
  height: 64rpx;
  padding: 0 20rpx;
  background: #F5F6F8;
  border-radius: 14rpx;
  font-size: 27rpx;
}
.tag-add { margin-left: 20rpx; font-size: 28rpx; color: #B3B9BF; }
.tag-add.on { color: #45A888; }

/* ---------------- 日期底部面板（设计图 2）：贴屏幕底的整宽面板，月历周一起始 ---------------- */
.date-sheet {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  background: #FFFFFF;
  border-radius: 48rpx 48rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
  transform: translate3d(0, 100%, 0);
  visibility: hidden;
  will-change: transform;
  /* 落下：加速曲线，短促 */
  transition: transform 0.24s cubic-bezier(0.4, 0, 1, 1), visibility 0s linear 0.24s;
}
.date-sheet.date-sheet-on {
  transform: translate3d(0, 0, 0);
  visibility: visible;
  /* 滑入：晚 0.06s 起步（让 tabBar 先让位），减速收尾 */
  transition: transform 0.36s cubic-bezier(0.22, 1, 0.36, 1) 0.06s;
}
.date-handle { width: 64rpx; height: 8rpx; margin: 14rpx auto 0; border-radius: 4rpx; background: #D8DADD; }
.date-head { position: relative; height: 104rpx; display: flex; align-items: center; justify-content: center; }
.cal-title { display: flex; align-items: center; font-size: 40rpx; color: #1A1A1A; }
.cal-caret {
  margin-left: 14rpx;
  border-left: 11rpx solid transparent;
  border-right: 11rpx solid transparent;
  border-top: 13rpx solid #1A1A1A;
}
.cal-today {
  position: absolute;
  right: 28rpx; top: 50%;
  margin-top: -33rpx;
  padding: 0 24rpx;
  height: 66rpx;
  line-height: 66rpx;
  font-size: 26rpx;
  color: #2E9C7C;
  background: #E9F5F0;
  border-radius: 33rpx;
}
.cal-week { display: flex; padding: 0 20rpx; height: 64rpx; align-items: center; }
.cw { flex: 1; text-align: center; font-size: 28rpx; color: #1A1A1A; }
/* 固定留 6 行高度：不同月份行数不同，面板高度不跳 */
.cal-grid { display: flex; flex-wrap: wrap; align-content: flex-start; min-height: 444rpx; padding: 0 20rpx 16rpx; }
.cal-slot { width: 14.2857%; height: 74rpx; display: flex; align-items: center; justify-content: center; }
.cal-cell {
  width: 66rpx; height: 66rpx;
  line-height: 66rpx;
  text-align: center;
  font-size: 34rpx;
  color: #1A1A1A;
  border-radius: 50%;
  transition: background-color 0.18s ease, color 0.18s ease;
}
.cal-cell.wk { color: #45A888; }
.cal-cell.today { color: #2E9C7C; font-weight: 700; }
.cal-cell.sel { background: #51B090; color: #FFFFFF; font-weight: 600; }

/* ---------------- 日期浮层·时间行（原生 time picker 触发） ---------------- */
.dt-time {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  padding: 20rpx 28rpx;
  border-top: 1rpx solid #F0F1F2;
}
.dt-time-ico {
  position: relative;
  width: 52rpx; height: 52rpx;
  border-radius: 50%;
  background: #45A888;
  flex-shrink: 0;
}
.dt-time-ico::before {
  content: '';
  position: absolute;
  left: 50%; top: 13rpx;
  width: 3rpx; height: 15rpx;
  background: #FFFFFF;
  border-radius: 2rpx;
  transform: translateX(-50%);
}
.dt-time-ico::after {
  content: '';
  position: absolute;
  left: 23rpx; top: 26rpx;
  width: 13rpx; height: 3rpx;
  background: #FFFFFF;
  border-radius: 2rpx;
}
.dt-time-label { margin-left: 20rpx; font-size: 30rpx; color: #1A1A1A; }
.dt-time-val { margin-left: auto; font-size: 32rpx; color: #1A1A1A; }
.dt-time-arrow {
  width: 14rpx; height: 14rpx;
  margin: 0 6rpx 0 14rpx;
  border-top: 3rpx solid #B3B9BF;
  border-right: 3rpx solid #B3B9BF;
  transform: rotate(45deg);
}

/* ---------------- 日期浮层·取消 / 完成 */
.dt-actions { display: flex; padding: 8rpx 28rpx 28rpx; }
.dt-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
}
.dt-cancel { background: #E9EAEC; color: #1A1A1A; }
.dt-cancel-hover { background: #DEDFE2; }
.dt-ok { margin-left: 30rpx; background: #45A888; color: #FFFFFF; }
.dt-ok-hover { background: #3E9E80; }
