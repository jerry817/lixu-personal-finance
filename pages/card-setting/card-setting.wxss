/* pages/card-setting/card-setting.wxss */
.page { height: 100vh; overflow: hidden; }

/* ---------------- 顶部栏 */
.hd {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 50;
  background: #F2F3F5;
}
.hd-row {
  position: relative;
  height: 88rpx;
  display: flex;
  align-items: center;
}
.hd-back {
  position: absolute;
  left: 24rpx;
  width: 52rpx; height: 52rpx;
}
.hd-title {
  flex: 1;
  text-align: center;
  font-size: 36rpx;
  font-weight: 600;
}

/* ---------------- 预览卡片 */
.sum-card {
  position: relative;
  margin: 0 24rpx;
  border-radius: 28rpx;
  padding: 32rpx 30rpx 30rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #E9F5F0 0%, #D8ECE5 100%);
  box-shadow: 0 6rpx 20rpx rgba(80, 150, 125, 0.12);
}
.sum-row { display: flex; position: relative; z-index: 2; }
.sum-cell { flex: 1; display: flex; flex-direction: column; }
.sum-label { font-size: 24rpx; color: #8C99A8; }
.sum-value {
  margin-top: 10rpx;
  font-size: 33rpx;
  font-weight: 700;
  color: #1F2A26;
}
.sum-big { position: relative; z-index: 2; margin-top: 26rpx; display: flex; flex-direction: column; }
.sum-big-label { font-size: 25rpx; color: #8C99A8; }
.sum-big-value {
  margin-top: 6rpx;
  font-size: 62rpx;
  line-height: 1.05;
  font-weight: 700;
  color: #43A787;
}

.deco { position: absolute; left: 0; top: 0; right: 0; bottom: 0; z-index: 1; }
.mt { position: absolute; border-radius: 50%; }
.mt1 { width: 380rpx; height: 210rpx; left: -70rpx; bottom: -90rpx; background: #D3E8E1; }
.mt2 { width: 300rpx; height: 180rpx; left: 130rpx; bottom: -95rpx; background: #DAEEE8; }
.mt3 { width: 280rpx; height: 170rpx; right: 30rpx; bottom: -85rpx; background: #CFE6DE; }
.cactus { position: absolute; border-radius: 16rpx; }
.c1 { width: 28rpx; height: 160rpx; right: 118rpx; bottom: 0; background: #4E9C84; transform: rotate(-4deg); }
.c2 { width: 24rpx; height: 128rpx; right: 84rpx; bottom: 0; background: #66B097; transform: rotate(5deg); }
.c3 { width: 20rpx; height: 96rpx; right: 158rpx; bottom: 0; background: #79BEA4; transform: rotate(-9deg); }
.carm { position: absolute; border-radius: 10rpx; }
.ca1 { width: 14rpx; height: 48rpx; right: 146rpx; bottom: 92rpx; background: #4E9C84; transform: rotate(58deg); }
.ca2 { width: 12rpx; height: 42rpx; right: 66rpx; bottom: 78rpx; background: #66B097; transform: rotate(-55deg); }
.leaf { position: absolute; border-radius: 50%; }
.l1 { width: 52rpx; height: 26rpx; right: 26rpx; bottom: 22rpx; background: #3E8F76; transform: rotate(-22deg); }
.l2 { width: 44rpx; height: 22rpx; right: 176rpx; bottom: 14rpx; background: #56A68B; transform: rotate(18deg); }
.flower { position: absolute; border-radius: 50%; background: #E89A9B; }
.flower::after {
  content: '';
  position: absolute;
  width: 6rpx; height: 6rpx;
  border-radius: 50%;
  background: #FBE3D8;
  left: 50%; top: 50%;
  transform: translate(-50%, -50%);
}
.f1 { width: 18rpx; height: 18rpx; right: 92rpx; top: 92rpx; }
.f2 { width: 14rpx; height: 14rpx; right: 150rpx; top: 62rpx; }
.f3 { width: 12rpx; height: 12rpx; right: 60rpx; top: 126rpx; }

/* ---------------- 设置列表 */
.set-list {
  margin: 28rpx 24rpx 0;
  padding: 0 30rpx;
}
.set-row {
  position: relative;
  height: 120rpx;
  display: flex;
  align-items: center;
}
.row-line { border-bottom: 1rpx solid #F0F1F3; }
.sr-label { font-size: 32rpx; color: #1A1A1A; }
.sr-current {
  margin-left: auto;
  font-size: 28rpx;
  color: #9AA0A6;
}
.sr-chev { width: 40rpx; height: 40rpx; margin-left: 10rpx; }

.tip-text {
  text-align: center;
  font-size: 24rpx;
  color: #B3B9BF;
  margin-top: 40rpx;
  padding: 0 60rpx;
}

/* ---------------- 指标选择弹层（底部上滑、可滚动） */
.pick-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 60;
  background: rgba(0, 0, 0, 0.35);
}
.pick-pop {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 70;
  height: 78vh;
  display: flex;
  flex-direction: column;
  background: #FFFFFF;
  border-radius: 28rpx 28rpx 0 0;
  padding: 28rpx 30rpx calc(40rpx + env(safe-area-inset-bottom));
}
.pick-head {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 6rpx 14rpx;
}
.pick-title { font-size: 31rpx; font-weight: 700; color: #1F2A26; }
.pick-close { font-size: 46rpx; line-height: 1; color: #9AA3AD; padding: 0 10rpx; }
.pick-body {
  flex: 1;
  min-height: 0;
  margin: 0 -6rpx;
}
.pk-group { padding: 0 6rpx; }
.pk-group-label {
  display: block;
  font-size: 23rpx;
  color: #9AA3AD;
  padding: 16rpx 12rpx 6rpx;
}
.pk-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 20rpx;
  border-radius: 16rpx;
}
.pk-name { font-size: 28rpx; color: #2A333C; }
.pk-item.pk-on { background: #E9F5F0; }
.pk-item.pk-on .pk-name { color: #3E9E80; font-weight: 600; }
.pk-tick { font-size: 28rpx; color: #45A888; }
