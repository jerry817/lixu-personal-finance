/* pages/about/about.wxss */
.page { min-height: 100vh; padding-bottom: 60rpx; }

.block {
  margin: 24rpx;
  padding: 30rpx;
}
.logo-row { display: flex; align-items: center; }
.logo { width: 96rpx; height: 96rpx; }
.logo-text { margin-left: 22rpx; display: flex; flex-direction: column; }
.app-name { font-size: 36rpx; font-weight: 700; color: #1F2A26; }
.app-ver { margin-top: 8rpx; font-size: 24rpx; color: #9AA3AD; }

.h {
  display: block;
  font-size: 31rpx;
  font-weight: 700;
  color: #1F2A26;
  margin-bottom: 16rpx;
}
.p {
  display: block;
  margin-top: 12rpx;
  font-size: 27rpx;
  color: #5A6570;
  line-height: 1.7;
}
.li {
  font-size: 27rpx;
  color: #5A6570;
  line-height: 2;
}

/* 版本更新 */
.ver { display: flex; align-items: flex-start; padding: 12rpx 0; }
.ver-no { flex-shrink: 0; width: 100rpx; font-size: 27rpx; font-weight: 700; color: #2E9C7C; line-height: 1.7; }
.ver-note { flex: 1; min-width: 0; font-size: 27rpx; color: #5A6570; line-height: 1.7; }
