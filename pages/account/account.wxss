/* pages/account/account.wxss */
.page { min-height: 100vh; }

/* 资产横幅 */
.banner {
  margin: 24rpx;
  border-radius: 26rpx;
  padding: 32rpx 32rpx 30rpx;
  background: linear-gradient(135deg, #49A989 0%, #3C9A7C 100%);
  box-shadow: 0 10rpx 26rpx rgba(60, 150, 120, 0.3);
}
.b-top { display: flex; align-items: center; justify-content: space-between; }
.b-top-right { display: flex; align-items: center; }
.b-count { font-size: 22rpx; color: rgba(255,255,255,0.7); margin-right: 16rpx; }
.b-label { font-size: 27rpx; color: rgba(255,255,255,0.82); }
.b-eye { width: 44rpx; height: 44rpx; }
.b-net {
  margin-top: 12rpx;
  font-size: 68rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.1;
}
.b-sub { margin-top: 22rpx; display: flex; }
.bs-cell { display: flex; align-items: baseline; margin-right: 60rpx; }
.bs-l { font-size: 26rpx; color: rgba(255,255,255,0.8); }
.bs-v { margin-left: 10rpx; font-size: 32rpx; color: #FFFFFF; font-weight: 600; }
.bs-v.red { color: #FFE1E0; }

/* 债务 / 待报销 / 定期存款 */
.mini-row {
  display: flex;
  margin: 0 24rpx;
}
.mini {
  flex: 1;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 22rpx 16rpx;
  display: flex;
  flex-direction: column;
  margin-right: 14rpx;
}
.mini:last-child { margin-right: 0; }
.m-label { font-size: 23rpx; color: #8C99A8; }
.m-val { margin-top: 10rpx; font-size: 30rpx; font-weight: 600; color: #2A333C; }
.m-val.green { color: #43A787; }
.m-val.red { color: #F25350; }
.m-val.m-val-off { color: #B3B9BF; }
/* 债务卡：应付 / 应收两行 */
.m-line { margin-top: 8rpx; display: flex; align-items: baseline; }
.m-tag { font-size: 21rpx; color: #9AA3AD; margin-right: 8rpx; flex-shrink: 0; }
.m-val-s { font-size: 26rpx; font-weight: 600; color: #2A333C; min-width: 0; }
.m-val-s.green { color: #43A787; }
.m-val-s.red { color: #F25350; }

/* 工具栏：排序 */
.tool-bar {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin: 20rpx 24rpx 0;
}
.tool-sort {
  display: flex;
  align-items: center;
}
.sort-label { font-size: 24rpx; color: #9AA3AD; margin-right: 12rpx; }
.sort-options { display: flex; }
.sort-opt {
  font-size: 24rpx;
  color: #5A6570;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  margin-left: 6rpx;
  background: #F2F4F5;
}
.sort-opt.on {
  color: #FFFFFF;
  background: #45A888;
}

/* 账户列表 */
.list { margin: 22rpx 24rpx 0; padding: 0 28rpx; }
.list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0 16rpx;
  border-bottom: 1rpx solid #F2F3F5;
}
.lh-title { font-size: 28rpx; font-weight: 600; color: #1F2A26; }
.acc-row {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
}
.acc-row.line { border-bottom: 1rpx solid #F2F3F5; }
.acc-icon { width: 68rpx; height: 68rpx; flex-shrink: 0; }
.acc-mid {
  margin-left: 20rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.acc-name { font-size: 28rpx; color: #1F2A26; }
.acc-sub { margin-top: 6rpx; display: flex; align-items: center; }
.acc-type {
  font-size: 20rpx;
  color: #9AA3AD;
  background: #F5F6F7;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}
.acc-bal { font-size: 30rpx; font-weight: 600; }
/* 在存定存合计：左下角账户类型标签右侧的灰色小字 */
.acc-dep { margin-left: 14rpx; font-size: 22rpx; color: #B3B9BF; }
/* 可折叠分组卡表头（资产 / 信贷共用） */
.fold-head { border-bottom: none; }
.fold-total { margin-left: auto; font-size: 32rpx; font-weight: 600; color: #1A1A1A; }
.fold-arrow {
  width: 16rpx; height: 16rpx; margin: -6rpx 8rpx 0 20rpx;
  border-right: 3rpx solid #1A1A1A; border-bottom: 3rpx solid #1A1A1A;
  transform: rotate(45deg); transition: transform 0.2s;
}
.fold-arrow-up { margin-top: 8rpx; transform: rotate(-135deg); }
.cr-row { display: flex; align-items: flex-end; padding: 22rpx 0 26rpx; }
.cr-row.line { border-bottom: 1rpx solid #F2F3F5; }
.cr-mid { flex: 1; min-width: 0; margin-left: 20rpx; }
.cr-top { display: flex; align-items: center; justify-content: space-between; }
.cr-bar { margin-top: 16rpx; height: 12rpx; border-radius: 6rpx; background: #EAF5F0; overflow: hidden; }
.cr-fill { height: 100%; border-radius: 6rpx; background: #45A888; }
.cr-cap { display: block; margin-top: 14rpx; font-size: 26rpx; color: #1F2A26; }
.amt-dark { color: #1A1A1A; }
.amt-red { color: #F25350; }
.amt-green { color: #43A787; }

/* 隐藏账户入口 */
.hidden-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #9AA3AD;
  padding: 22rpx 0 0;
}
.ht-arrow {
  margin-left: 8rpx;
  font-size: 20rpx;
  transition: transform 0.2s;
}
.ht-arrow.up { transform: rotate(180deg); }

/* 隐藏账户面板 */
.hidden-panel {
  margin: 16rpx 24rpx 0;
  padding: 0 28rpx;
}
.hp-title {
  font-size: 24rpx;
  color: #9AA3AD;
  padding: 20rpx 0 12rpx;
}
.hp-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}
.hp-row.line { border-bottom: 1rpx solid #F2F3F5; }
.hp-icon { width: 56rpx; height: 56rpx; flex-shrink: 0; }
.hp-name {
  margin-left: 16rpx;
  flex: 1;
  font-size: 28rpx;
  color: #5A6570;
}
.hp-restore {
  font-size: 24rpx;
  color: #45A888;
  padding: 6rpx 20rpx;
  border: 1rpx solid #45A888;
  border-radius: 20rpx;
}

.empty {
  text-align: center;
  color: #B3B9BF;
  font-size: 26rpx;
  padding: 60rpx 0;
}

.tab-space { height: 150rpx; } /* 给悬浮钮留位，最后一个账户不被遮住 */
