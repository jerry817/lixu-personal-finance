/* pages/account-detail/account-detail.wxss */
.page { min-height: 100vh; }

/* ---------- 顶部栏 + ⋮ 二级菜单 ---------- */
.hd { position: fixed; top: 0; left: 0; right: 0; z-index: 50; background: #F2F3F5; }
.hd-inner { position: relative; display: flex; align-items: center; }
.hd-back { position: absolute; left: 24rpx; width: 52rpx; height: 52rpx; }
.hd-title { flex: 1; padding: 0 200rpx; text-align: center; font-size: 35rpx; font-weight: 600; color: #1A1A1A;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.hd-more {
  position: absolute;
  width: 64rpx; height: 64rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.hd-dot { width: 9rpx; height: 9rpx; border-radius: 50%; background: #1A1A1A; margin: 4rpx 0; }

.hd-stat {
  position: absolute;
  font-size: 30rpx; color: #1A1A1A;
}
.hd-stat.hd-stat-on { color: #2E9C7C; }

.menu-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 60; }
.menu {
  position: fixed; z-index: 61;
  min-width: 240rpx;
  margin-top: 8rpx;
  padding: 8rpx 0;
  border-radius: 20rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.14);
}
.menu-item { padding: 26rpx 36rpx; font-size: 31rpx; color: #1A1A1A; white-space: nowrap; }
.menu-hover { background: #F4F6F5; }
.menu-del { color: #F25350; }

.head {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 36rpx;
}
.h-icon { width: 110rpx; height: 110rpx; }
.h-type { margin-top: 12rpx; font-size: 26rpx; color: #8C99A8; }
.h-bal { margin-top: 10rpx; font-size: 72rpx; font-weight: 700; line-height: 1.1; }
.h-bal.green { color: #43A787; }
.h-bal.red { color: #F25350; }
.h-dep { margin-top: 8rpx; font-size: 24rpx; color: #B3B9BF; }

/* ---------- 应付款 / 应收款账户：汇总卡 + 操作行 ---------- */
.d-card {
  margin: 24rpx 24rpx 0;
  padding: 34rpx 30rpx 30rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #51B090 0%, #3E9E80 100%);
}
.d-row { display: flex; }
.d-cell { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.d-label { font-size: 27rpx; color: rgba(255, 255, 255, 0.88); }
.d-big { margin-top: 12rpx; font-size: 56rpx; line-height: 1.1; font-weight: 600; color: #FFFFFF; }
.d-row-sub { margin-top: 36rpx; }
.d-row-sub2 { margin-top: 24rpx; }
.d-sub { font-size: 27rpx; color: rgba(255, 255, 255, 0.88); }
.d-actions {
  margin: 24rpx 24rpx 0;
  height: 108rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
}
.d-act {
  flex: 1;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 31rpx;
  color: #1F2A26;
}
.d-act-hover { background: #F4F6F5; }
.d-act-ic { width: 44rpx; height: 44rpx; margin-right: 18rpx; }
.d-sep { width: 2rpx; height: 56rpx; background: #C9CED3; }

.day-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 30rpx 12rpx;
}
.dh-left { display: flex; align-items: baseline; }
.dh-md { font-size: 32rpx; font-weight: 700; color: #1F2A26; }
.dh-week { margin-left: 18rpx; font-size: 25rpx; color: #9AA3AD; }
.dh-summary { display: flex; align-items: center; }
.dh-sum-label { font-size: 25rpx; color: #9AA3AD; margin-left: 16rpx; }
.dh-sum-val { font-size: 28rpx; font-weight: 600; margin-left: 6rpx; }
.dh-sum-val.income { color: #43A787; }
.dh-sum-val.expense { color: #F25350; }

.day-card { margin: 0 24rpx; }
.bill { display: flex; align-items: center; padding: 26rpx 28rpx; }
.bill-line { border-bottom: 1rpx solid #F0F1F3; }
.bill-icon { width: 58rpx; height: 58rpx; flex-shrink: 0; }
.bill-mid { flex: 1; min-width: 0; margin-left: 20rpx; display: flex; flex-direction: column; }
.bill-title-row { display: flex; align-items: center; }
.bill-title { font-size: 30rpx; color: #1A1A1A; }
.bill-sub-row { margin-top: 8rpx; display: flex; align-items: center; flex-wrap: wrap; }
.bill-tag {
  font-size: 20rpx;
  color: #45A888;
  background: #E9F5F0;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-right: 10rpx;
}
.bill-remark { font-size: 24rpx; color: #9AA0A6; }
.bill-right { display: flex; flex-direction: column; align-items: flex-end; flex-shrink: 0; margin-left: 16rpx; }
.bill-amt { font-size: 34rpx; font-weight: 600; }
/* 借入 / 借出卡片：金额下方的资金流向「来源 → 去向」 */
.bill-debt-path { margin-top: 8rpx; font-size: 24rpx; color: #9AA0A6; }
.amt-dark { color: #1A1A1A; }
.amt-red { color: #F25350; }
.amt-green { color: #43A787; }

.empty { text-align: center; color: #B3B9BF; font-size: 26rpx; padding: 60rpx 0; }

.tab-space { height: 50rpx; }

/* ---------- 统计弹层 ---------- */
.st-mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 80;
  background: rgba(0, 0, 0, 0.45);
  display: flex; flex-direction: column; justify-content: flex-end;
}
.st-sheet {
  background: #FFFFFF; border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 28rpx calc(36rpx + env(safe-area-inset-bottom));
}
.st-title { text-align: center; font-size: 30rpx; font-weight: 600; margin-bottom: 12rpx; }
.st-row { display: flex; align-items: center; padding: 26rpx 0; border-bottom: 1rpx solid #F2F3F5; }
.st-head { padding: 12rpx 0; font-size: 24rpx; color: #9AA3AD; }
.st-c { flex: 1; text-align: right; font-size: 28rpx; color: #1A1A1A; }
.st-first { flex: 0 0 120rpx; text-align: left; }
.st-red { color: #F25350; }
.st-green { color: #43A787; }

/* ---------- 报销账户：账单状态标签（待报销 / 已报销 / 已结束 / 退款等） ---------- */
.bill-title-row { flex-wrap: wrap; }
.bd {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  font-size: 22rpx;
  line-height: 1.5;
  border-radius: 8rpx;
  flex-shrink: 0;
}
.bd-pend { background: #DCE8F3; color: #5B86A8; }
.bd-done { background: #E9F5F0; color: #3E9E80; }
.bd-gray { background: #F0F1F3; color: #8A9199; }
.bd-refund { background: #E9F5F0; color: #3E9E80; border: 1rpx solid #8FCBB7; }
