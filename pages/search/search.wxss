/* pages/search/search.wxss */
.page { min-height: 100vh; }

/* ---------------- 顶部 */
.sh {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 50;
  background: #F2F3F5;
}
.sh-row {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
}
.sh-back { width: 52rpx; height: 52rpx; }
.search-box {
  display: flex;
  align-items: center;
  height: 72rpx;
  background: #FFFFFF;
  border-radius: 36rpx;
  padding: 0 20rpx;
  margin: 0 16rpx;
  width: 490rpx;
}
.sb-icon { width: 34rpx; height: 34rpx; margin-right: 10rpx; }
.sb-input { flex: 1; font-size: 28rpx; }
.sb-ph { color: #B3B9BF; }
.sb-clear {
  width: 40rpx; height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  color: #B3B9BF;
  font-size: 34rpx;
}

.filter-tabs {
  white-space: nowrap;
  padding: 6rpx 24rpx 8rpx;
}
.ft-tab {
  display: inline-flex;
  align-items: center;
  height: 60rpx;
  padding: 0 30rpx;
  margin-right: 14rpx;
  background: #FFFFFF;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #6B7075;
}
.ft-on { background: #45A888; color: #FFFFFF; }

.date-filter {
  display: flex;
  align-items: center;
  padding: 8rpx 24rpx 20rpx;
}
.df-date {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: #B3B9BF;
}
.df-date.df-set { color: #2FA984; }
.df-line { margin: 0 18rpx; color: #9AA0A6; font-size: 26rpx; }
.df-clear { margin-left: 24rpx; font-size: 26rpx; color: #F25350; }

/* ---------------- 结果列表 */
.results { padding-top: 350rpx; }
.results-tip { padding-top: 410rpx; padding-bottom: 150rpx; } /* 精准导出：顶部多一行提示，底部给已选操作条让位 */

/* 日期分组 + 账单卡片：与首页（pages/index）同一套样式，改动时两处一起改 */
.day-head {
  display: flex;
  align-items: baseline;
  padding: 24rpx 30rpx 10rpx;
}
.day-md { font-size: 32rpx; font-weight: 700; }
.day-week { font-size: 28rpx; color: #9AA0A6; margin-left: 22rpx; }
.day-sum { margin-left: auto; display: flex; align-items: baseline; }
.ds-label { font-size: 26rpx; color: #9AA0A6; }
.ds-green { font-size: 27rpx; color: #43A787; font-weight: 600; }
.ds-red { font-size: 27rpx; color: #F25350; font-weight: 600; }
.ds-gap { margin-left: 18rpx; }

.day-card { margin: 0 24rpx; }
.bill { display: flex; align-items: center; padding: 18rpx; min-height: 116rpx; box-sizing: border-box; }
.bill-line { border-bottom: 1rpx solid #F0F1F3; }
.bill-icon { width: 50rpx; height: 50rpx; flex-shrink: 0; }
.bill-mid { flex: 1; min-width: 0; margin-left: 20rpx; display: flex; flex-direction: column; }
.bill-title-row { display: flex; align-items: center; }
.bill-title { font-size: 28rpx; color: #1A1A1A; }
.bill-badge {
  margin-left: 12rpx;
  font-size: 19rpx;
  line-height: 1.5;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}
.bd-reimb { background: #FDECEC; color: #F25350; }
.bd-gray { background: #F0F1F3; color: #8A9199; }
.bd-refund {
  background: #E9F5F0;
  color: #3E9E80;
  border: 1rpx solid #8FCBB7;
}
.bill-sub-row { margin-top: 10rpx; display: flex; align-items: center; flex-wrap: wrap; }
.bill-tag {
  font-size: 20rpx;
  color: #45A888;
  background: #E9F5F0;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-right: 10rpx;
}
.bill-remark { font-size: 24rpx; color: #9AA0A6; }
.bill-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
  margin-left: 16rpx;
}
.bill-amt { font-size: 31rpx; font-weight: 600; line-height: 44rpx;}
.amt-row {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
}
.bill-amt-orig {
  margin-right: 10rpx;
  font-size: 24rpx;
  color: #B3B9BF;
  text-decoration: line-through;
}
.bill-account { margin-top: 8rpx; font-size: 22rpx; color: #B3B9BF; }
/* 借入 / 借出卡片：金额下方的资金流向「来源 → 去向」 */
.bill-debt-path {margin-top: 4rpx; font-size: 24rpx; color: #9AA0A6; line-height: 32rpx;}
.amt-dark { color: #1A1A1A; }
.amt-red { color: #F25350; }
.amt-green { color: #43A787; }

.result-bottom {
  text-align: center;
  color: #B3B9BF;
  font-size: 24rpx;
  padding: 36rpx 0 60rpx;
}

/* ---------------- 空状态 */
.empty {
  padding: 150rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.empty-icon {
  width: 120rpx; height: 120rpx;
  border-radius: 50%;
  background: #ECEEF0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.empty-icon image { width: 56rpx; height: 56rpx; }
.empty-text { margin-top: 28rpx; font-size: 30rpx; color: #6B7075; }
.empty-tip { margin-top: 12rpx; font-size: 24rpx; color: #B3B9BF; }

/* ---------------- 精准导出：多选 */
.pick-tip { padding: 0 30rpx 18rpx; font-size: 24rpx; color: #45A888; }
.pick {
  width: 38rpx; height: 38rpx; margin-right: 18rpx; flex-shrink: 0; box-sizing: border-box;
  border: 3rpx solid #C9CED3; border-radius: 50%;
}
.pick-on { border-color: #45A888; background: #45A888; }
.pick-on::after {
  content: ''; display: block; width: 10rpx; height: 18rpx; margin: 3rpx auto 0;
  border: solid #FFFFFF; border-width: 0 4rpx 4rpx 0; transform: rotate(45deg);
}
.pick-bar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 60;
  display: flex; align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #FFFFFF; box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
}
.pb-cancel, .pb-all { padding: 12rpx 8rpx; font-size: 28rpx; color: #6B737B; }
.pb-count { flex: 1; text-align: center; font-size: 30rpx; font-weight: 600; color: #1A1A1A; }
.pb-all { margin-right: 16rpx; color: #2E7E66; }
.pb-go {
  margin: 0; width: 180rpx; height: 76rpx; line-height: 76rpx; padding: 0;
  border-radius: 38rpx; background: #45A888; color: #FFFFFF; font-size: 30rpx; font-weight: 600;
}
.pb-go::after { border: none; }
