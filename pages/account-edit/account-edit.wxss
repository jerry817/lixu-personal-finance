/* pages/account-edit/account-edit.wxss */
.page { min-height: 100vh; padding-top: 24rpx; }

.form { margin: 0 24rpx 24rpx; padding: 0 28rpx; }
.f-row {
  display: flex;
  align-items: center;
  min-height: 108rpx;
  border-bottom: 1rpx solid #F2F3F5;
}
.f-row.last { border-bottom: none; }
.f-label {
  width: 150rpx;
  font-size: 30rpx;
  color: #1F2A26;
  flex-shrink: 0;
}
.f-label.f-wide { width: auto; flex: 1; }
.f-input { flex: 1; min-width: 0; font-size: 30rpx; }
.ph { color: #B3B9BF; font-size: 30rpx; }
.f-value { margin-left: auto; font-size: 30rpx; color: #9AA3AD; }
.f-icon { margin-left: auto; width: 56rpx; height: 56rpx; }
.f-switch { margin-left: auto; }
.f-right { text-align: right; }
.f-dark { color: #1F2A26; }
/* 开关行：主标题 + 灰色副标题 */
.f-text { flex: 1; min-width: 0; display: flex; flex-direction: column; padding: 18rpx 0; }
.f-text .f-label { width: auto; }
.f-sub { margin-top: 6rpx; font-size: 24rpx; color: #9AA3AD; line-height: 1.4; }
.f-note {
  padding: 4rpx 0 24rpx 150rpx;
  font-size: 23rpx;
  color: #B3B9BF;
  line-height: 1.5;
}

.f-note.f-note-flush { padding-left: 28rpx; padding-right: 28rpx; margin: 0 24rpx; }

/* 右箭头：纯 CSS，不占图片/字体体积 */
.chev {
  width: 14rpx;
  height: 14rpx;
  margin: 0 6rpx 0 14rpx;
  border-top: 3rpx solid #B3B9BF;
  border-right: 3rpx solid #B3B9BF;
  transform: rotate(45deg);
  flex-shrink: 0;
}

.tip {
  margin: 0 40rpx;
  font-size: 24rpx;
  color: #9AA3AD;
  line-height: 1.7;
}
.tip-gap { margin-top: 12rpx; }

/* 底部保存栏 */
.bar-space { height: calc(160rpx + env(safe-area-inset-bottom)); }
.save-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #F2F3F5;
  box-shadow: 0 -6rpx 20rpx rgba(0, 0, 0, 0.04);
}
.save-btn {
  height: 92rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #51B090 0%, #3E9E80 100%);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}
.save-btn-hover { opacity: 0.85; }

/* 图标选择弹层 */
.mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: 50;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}
.sheet {
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));
}
.sheet-title { text-align: center; font-size: 30rpx; font-weight: 600; margin-bottom: 24rpx; }
.icon-grid { display: flex; flex-wrap: wrap; }
.ig-item {
  width: 20%;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ig-img {
  width: 76rpx; height: 76rpx;
  padding: 6rpx;
  border-radius: 50%;
  border: 3rpx solid transparent;
  box-sizing: content-box;
}
.ig-on .ig-img { border-color: #45A888; }

/* ---------- 债务分组表单 ---------- */
/* picker 占满整行，内部行样式与普通行一致 */
.f-pick { display: block; }

/* 附件预览 */
.att-list { display: flex; flex-wrap: wrap; padding: 16rpx 0 20rpx; }
.att-chip { position: relative; margin: 0 16rpx 16rpx 0; }
.att-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #F2F3F5;
}
.att-name {
  display: block;
  max-width: 240rpx;
  padding: 0 24rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: #F2F3F5;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #5A6570;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.att-x {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #FFFFFF;
  font-size: 26rpx;
  line-height: 34rpx;
  text-align: center;
}

/* ---------- 信贷分组：额度共享 / 年费弹层 ---------- */
.sh-row { display: flex; align-items: center; min-height: 100rpx; padding: 0 12rpx; border-bottom: 1rpx solid #F2F3F5; }
.sh-ico { width: 56rpx; height: 56rpx; margin-right: 20rpx; flex-shrink: 0; }
.sh-name { flex: 1; min-width: 0; font-size: 30rpx; color: #1F2A26; }
.sh-sub { font-size: 24rpx; color: #9AA3AD; margin-left: 16rpx; }
.sh-on { margin-left: 20rpx; font-size: 32rpx; color: #45A888; }
.sh-empty { padding: 32rpx 0 8rpx; text-align: center; font-size: 26rpx; color: #B3B9BF; }
.sh-form { padding: 0 12rpx; }
.sh-btns { display: flex; margin-top: 32rpx; }
.sh-btn {
  flex: 1; height: 92rpx; border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, #51B090 0%, #3E9E80 100%);
  color: #FFFFFF; font-size: 32rpx;
}
.sh-btn-gray { background: #F2F4F6; color: #555; margin-right: 20rpx; }
